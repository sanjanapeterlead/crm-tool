# Copy this file to .env.local and fill in real values.
# Run `npm run db:start` first — it prints these values for local development.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Used only for privileged operations (none required for V0's normal request path).
SUPABASE_SERVICE_ROLE_KEY=

# Calendly booking URL fallback used when an organization hasn't configured
# one yet in Settings. Optional.
CALENDLY_BOOKING_URL=https://calendly.com/your-team/intro-call
